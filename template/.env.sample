# Service Controls
# stackkit:begin frontend
## Enables the front end service redirect
# FRONT_END_URL=http://localhost:5173
# stackkit:end frontend

# GCP Controls

## Project for Google
PROJECT_ID=

## The name of the GCP resources to use (buckets, db, services)
NAMESPACE=

# stackkit:begin firebase
## Firebase emulator: on by default locally (`make emulator`), off when deployed.
## Set to false to use the real Google Cloud project from your computer.
# USE_EMULATOR=false
# stackkit:end firebase

# stackkit:begin gae
## App Engine version to deploy (main is default)
# VERSION=search
# stackkit:end gae

# stackkit:begin auth_iap,auth_firebase
# Auth Controls

## Email domains allowed to sign in, comma separated (blank allows any account)
VALID_DOMAINS=
# stackkit:end auth_iap,auth_firebase
